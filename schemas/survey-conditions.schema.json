{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "survey-conditions.schema.json",
  "title": "SurveyConditions",
  "description": "法令調査の抽出条件（docs/surveys/<survey-id>/conditions.yaml）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "survey_id",
    "source_id",
    "law_type",
    "conditions"
  ],
  "properties": {
    "survey_id": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "source_id": {
      "description": "config/sources.yaml の情報源。",
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "law_type": {
      "description": "e-Gov法令APIの法令種別。",
      "enum": [
        "Act",
        "CabinetOrder",
        "MinisterialOrdinance"
      ]
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/condition"
      }
    }
  },
  "$defs": {
    "condition": {
      "title": "SurveyCondition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "burden_category",
        "method",
        "description"
      ],
      "properties": {
        "condition_id": {
          "$ref": "common.schema.json#/$defs/kebabId"
        },
        "burden_category": {
          "$ref": "burden.schema.json#/properties/category"
        },
        "method": {
          "title": "SurveyMethod",
          "description": "category: e-Govの法令分類、keyword: 全文検索、articles: 指定した条項の取得（列挙規定の記録）。",
          "enum": [
            "category",
            "keyword",
            "articles"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category_cd": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "keyword": {
          "type": "string",
          "minLength": 1
        },
        "law_id": {
          "$ref": "common.schema.json#/$defs/lawId"
        },
        "elms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/elm"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "category"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "category_cd"
            ],
            "properties": {
              "keyword": false,
              "law_id": false,
              "elms": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "keyword"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "keyword"
            ],
            "properties": {
              "category_cd": false,
              "law_id": false,
              "elms": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "articles"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "law_id",
              "elms"
            ],
            "properties": {
              "category_cd": false,
              "keyword": false
            }
          }
        }
      ]
    }
  }
}
