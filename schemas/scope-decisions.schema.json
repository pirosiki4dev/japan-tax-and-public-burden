{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope-decisions.schema.json",
  "title": "ScopeDecisions",
  "description": "対象・対象外の個別判断の記録（data/scope-decisions.yaml）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "decision": {
      "title": "ScopeDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "subject", "decision", "reason", "decided_at"],
      "properties": {
        "decision_id": { "$ref": "common.schema.json#/$defs/kebabId" },
        "subject": { "type": "string", "minLength": 1 },
        "decision": { "title": "ScopeDecisionResult", "enum": ["included", "excluded"] },
        "reason": { "type": "string", "minLength": 10 },
        "decided_at": { "$ref": "common.schema.json#/$defs/date" },
        "burden_id": { "$ref": "common.schema.json#/$defs/kebabId" },
        "source_urls": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/sourceUrl" }
        }
      },
      "if": { "properties": { "decision": { "const": "excluded" } }, "required": ["decision"] },
      "then": { "properties": { "burden_id": false } }
    }
  }
}
