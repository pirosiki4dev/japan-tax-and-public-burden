{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burden.schema.json",
  "title": "Burden",
  "description": "制度（data/burdens/<burden-id>/burden.yaml）。レベル1・2の情報を持つ。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "burden_id",
    "name",
    "category",
    "levying_body_type",
    "legal_bases",
    "liable_parties",
    "taxable_objects",
    "tax_base",
    "status",
    "source_url",
    "checked_at"
  ],
  "properties": {
    "burden_id": { "$ref": "common.schema.json#/$defs/kebabId" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "title": "BurdenCategory",
      "enum": ["national_tax", "local_tax", "social_insurance", "other_public_burden"]
    },
    "levying_body_type": {
      "title": "LevyingBodyType",
      "enum": ["national", "prefecture", "municipality", "insurer"]
    },
    "legal_bases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/legalReference" }
    },
    "liable_parties": {
      "description": "納税義務者・負担者。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/describedItem" }
    },
    "taxable_objects": {
      "description": "課税対象・負担の対象。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/describedItem" }
    },
    "tax_base": {
      "description": "課税標準・算定基礎。",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/describedItem" }
    },
    "status": {
      "title": "BurdenStatus",
      "enum": ["active", "promulgated_not_effective", "abolished"]
    },
    "source_url": { "$ref": "common.schema.json#/$defs/sourceUrl" },
    "checked_at": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}
