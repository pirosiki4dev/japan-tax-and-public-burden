{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-source.schema.json",
  "title": "LegalSource",
  "description": "根拠法令（data/legal-sources/<law-id>.yaml）。監視対象の一覧を兼ねる。",
  "type": "object",
  "additionalProperties": false,
  "required": ["law_id", "title", "reviewed_revision_id", "reviewed_at", "source_url"],
  "properties": {
    "law_id": { "$ref": "common.schema.json#/$defs/lawId" },
    "title": { "type": "string", "minLength": 1 },
    "law_number_raw": {
      "description": "法令番号の原文（例: 昭和六十三年法律第百八号）。",
      "type": "string",
      "minLength": 1
    },
    "reviewed_revision_id": {
      "description": "人がマスタへの反映を確認した最新の改正版のID（e-Gov法令APIの改正版ID）。",
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": { "$ref": "common.schema.json#/$defs/dateTime" },
    "source_url": { "$ref": "common.schema.json#/$defs/sourceUrl" }
  }
}
