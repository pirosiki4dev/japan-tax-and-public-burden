{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidates.schema.json",
  "title": "SurveyCandidates",
  "description": "抽出結果（surveys/first-release-scope/candidates.json）。プログラムが出力し、手で編集しない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "survey_id",
    "retrieved_at",
    "base_url",
    "law_type",
    "condition_results",
    "laws",
    "articles"
  ],
  "properties": {
    "survey_id": {
      "$ref": "common.schema.json#/$defs/kebabId"
    },
    "retrieved_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "base_url": {
      "$ref": "common.schema.json#/$defs/url"
    },
    "law_type": {
      "type": "string"
    },
    "condition_results": {
      "type": "array",
      "items": {
        "title": "SurveyConditionResult",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "law_count"
        ],
        "properties": {
          "condition_id": {
            "$ref": "common.schema.json#/$defs/kebabId"
          },
          "law_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_repealed_count": {
            "description": "廃止・失効のため除いた件数。",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/law"
      }
    },
    "articles": {
      "description": "articles条件で取得した条項の本文。",
      "type": "array",
      "items": {
        "title": "SurveyArticle",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "law_id",
          "elm",
          "law_revision_id",
          "text"
        ],
        "properties": {
          "condition_id": {
            "$ref": "common.schema.json#/$defs/kebabId"
          },
          "law_id": {
            "$ref": "common.schema.json#/$defs/lawId"
          },
          "elm": {
            "$ref": "common.schema.json#/$defs/elm"
          },
          "law_revision_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "law": {
      "title": "SurveyLaw",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "law_id",
        "law_title",
        "law_num",
        "category",
        "law_revision_id",
        "current_revision_status",
        "matched_conditions"
      ],
      "properties": {
        "law_id": {
          "$ref": "common.schema.json#/$defs/lawId"
        },
        "law_title": {
          "type": "string",
          "minLength": 1
        },
        "law_num": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "description": "e-Govの法令分類。",
          "type": "string"
        },
        "law_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "current_revision_status": {
          "type": "string",
          "minLength": 1
        },
        "matched_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/kebabId"
          }
        },
        "snippets": {
          "description": "全文検索で該当した文の抜粋（条件ごとに先頭の1文）。",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_id",
              "text"
            ],
            "properties": {
              "condition_id": {
                "$ref": "common.schema.json#/$defs/kebabId"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
