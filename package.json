{
  "name": "japan-tax-and-public-burden",
  "version": "0.0.0",
  "private": true,
  "description": "Structured data for taxes and public burdens in Japan",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run validate && npm run types:check && npm run architecture:check",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" \"surveys/**/*.test.ts\"",
    "validate": "node src/cli/validate.ts",
    "types:generate": "node src/cli/generate-types.ts",
    "types:check": "node src/cli/generate-types.ts --check",
    "architecture:check": "node src/cli/check-architecture.ts",
    "monitor": "node src/cli/monitor.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
